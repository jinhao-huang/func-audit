[env]
# Uncomment and fill in the project key, or export it from your shell.
# FUNC_AUDIT_API_KEY = ""

# Uncomment to override the defaults with your gateway's base URL and model ID.
# FUNC_AUDIT_BASE_URL = "https://api.deepseek.com"
# FUNC_AUDIT_MODEL = "deepseek-flash"

# Maximum active reports across CLI and workspace submissions.
# FUNC_AUDIT_CONCURRENCY = "2"
