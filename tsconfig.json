{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./app/*"] },
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": ["src", "app", ".react-router/types", "*.config.ts"]
}
